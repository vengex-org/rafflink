{
  "name": "rafflink",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "typecheck": "bun check --no-script",
    "test": "bun test",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "build": "bun run --filter '*' build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "oxlint": "^1.94.0"
  },
  "packageManager": "bun@1.4.5"
}

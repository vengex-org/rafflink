{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafflink",
  // The bundle of `bun run build`, which wrangler runs before `dev` and `deploy`.
  "main": "dist/worker.js",
  "build": { "command": "bun run build" },
  "compatibility_date": "2026-07-01",
  // Core imports `node:timers/promises`.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages and files come from the assets, which cost no Worker request; their headers are the
    // dist/_headers of the web build. The API and the sign-in routes run the Worker, the paths of
    // `apiPrefixes` in packages/core/src/http/api-paths.ts, and so do the pages search engines index,
    // `indexablePaths` in packages/core/src/http/static-headers.ts: the Worker writes PUBLIC_URL into their
    // canonical and Open Graph tags, which link previews need absolute.
    "run_worker_first": ["/api/*", "/auth/*", "/", "/privacy", "/terms"],
  },
  // Set PUBLIC_URL, TWITCH_CLIENT_ID and ADMIN_TWITCH_IDS under "vars" and the secrets with
  // `wrangler secret put`; every key is listed in .env.example.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rafflink",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/core/schema/accounts",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GiveawayRoomObject" },
      { "name": "QUEUE", "class_name": "TokenQueueDO" },
    ],
  },
  // Workers Rate Limiting counts per key in 60 second periods. The limits equal the defaults of
  // ENTRY_USER_LIMIT_PER_MINUTE, ENTRY_IP_LIMIT_PER_MINUTE, LEAVES_IP_LIMIT_PER_MINUTE and MODERATOR_IP_LIMIT_PER_MINUTE; a test keeps them equal.
  "ratelimits": [
    {
      "name": "ENTRY_USER_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    { "name": "ENTRY_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    {
      "name": "LEAVES_IP_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "MODERATOR_IP_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GiveawayRoomDO", "TokenQueueDO"] },
    // v2 and v3 drop every room stored before 2026-11-21 (rapid development, no data kept). Cloudflare refuses
    // to delete a class in the deploy that moves its binding away, so v2 adds the new class and v3 deletes the old.
    { "tag": "v2", "new_sqlite_classes": ["GiveawayRoomObject"] },
    { "tag": "v3", "deleted_classes": ["GiveawayRoomDO"] },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
}

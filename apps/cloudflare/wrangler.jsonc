{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafflink",
  // The bundle of `bun run build`, which wrangler runs before `dev` and `deploy`.
  "main": "dist/worker.js",
  "build": { "command": "bun run build" },
  "compatibility_date": "2026-07-01",
  // Core imports `node:timers/promises`.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker answers every page, because a giveaway page carries its own link preview, and leaves
    // the built files to the assets. Keep the extensions in step with what apps/web/public holds.
    "run_worker_first": ["/*", "!/*.js", "!/*.css", "!/*.png", "!/*.svg", "!/*.webmanifest"],
  },
  // Set PUBLIC_URL, TWITCH_CLIENT_ID and ADMIN_TWITCH_IDS under "vars" and the secrets with
  // `wrangler secret put`; every key is listed in .env.example.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rafflink",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/core/schema/accounts",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GiveawayRoomDO" },
      { "name": "QUEUE", "class_name": "TokenQueueDO" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GiveawayRoomDO", "TokenQueueDO"] }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
}

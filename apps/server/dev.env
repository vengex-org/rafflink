# Local development against the fake Twitch, the fake Kick and the fake YouTube (bun run dev). Fake values only; the real ones go in .env.
DEV_FAKE_TWITCH=true
PORT=3000
PUBLIC_URL=http://localhost:3000
# The fake Twitch is served by this server, so the Twitch URLs point back at it. Change them with PORT.
TWITCH_ID_BASE_URL=http://localhost:3000
TWITCH_HELIX_BASE_URL=http://localhost:3000
EVENTSUB_URL=ws://localhost:3000/eventsub/ws
TWITCH_CLIENT_ID=fake-client-id
TWITCH_CLIENT_SECRET=fake-client-secret
# The fake Kick is served by this server too, and takes the Kick app below as its own. Change the URLs with PORT.
DEV_FAKE_KICK=true
KICK_ID_BASE_URL=http://localhost:3000
KICK_API_BASE_URL=http://localhost:3000
KICK_CLIENT_ID=fake-kick-client-id
KICK_CLIENT_SECRET=fake-kick-client-secret
# The fake Google sign-in and YouTube API are served by this server too, with the Google client below.
DEV_FAKE_YOUTUBE=true
YOUTUBE_AUTH_BASE_URL=http://localhost:3000
YOUTUBE_TOKEN_BASE_URL=http://localhost:3000
YOUTUBE_API_BASE_URL=http://localhost:3000
YOUTUBE_CLIENT_ID=fake-youtube-client-id
YOUTUBE_CLIENT_SECRET=fake-youtube-client-secret
# The fake's default viewer, so signing in at the fake opens the admin page.
ADMIN_TWITCH_IDS=1000
SESSION_SECRET=dev-session-secret-not-for-production
# Key id, then 32 zero bytes in base64.
TOKEN_SEAL_KEYS=dev:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

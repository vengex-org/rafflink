# Local development against the fake Twitch (bun run dev). Fake values only; the real ones go in .env.
DEV_FAKE_TWITCH=true
PORT=3000
PUBLIC_URL=http://localhost:3000
# The fake Twitch is served by this server, so the Twitch URLs point back at it. Change them with PORT.
TWITCH_ID_BASE_URL=http://localhost:3000
TWITCH_HELIX_BASE_URL=http://localhost:3000
TWITCH_CLIENT_ID=fake-client-id
TWITCH_CLIENT_SECRET=fake-client-secret
# The fake's default viewer, so signing in at the fake opens the admin page.
ADMIN_TWITCH_IDS=1000
SESSION_SECRET=dev-session-secret-not-for-production
# Key id, then 32 zero bytes in base64.
TOKEN_SEAL_KEYS=dev:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
